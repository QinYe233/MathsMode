{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "vitest/globals"],
    // interval-arithmetic 1.1.3 自带 lib/index.d.ts，但 package.json 未声明 types 字段，
    // TS 无法自动发现。这里显式指向它（不复制、不伪造类型）。
    // interval-arithmetic-eval 未发布类型，由 src/types/interval-arithmetic-eval.d.ts 提供。
    "paths": {
      "interval-arithmetic": ["./node_modules/interval-arithmetic/lib/index.d.ts"]
    }
  },
  "include": ["src"]
}
